{
  "name": "@pawlr/seller",
  "version": "0.0.0",
  "private": true,
  "description": "Add Pawlr to an x402 service: agreed conditions, TickEvidence per tick, evidence and refund routes, Kite x402 paywall",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
