    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "@x402/hono": "^2.30.0",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "viem": "2.57.19",
    "zod": "^4.6.7",
    "@pawlr/protocol": "workspace:*"
  }
}
