{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://console.16-61-50-207.sslip.io/console"
    },
    {
      "source": "/console",
      "destination": "https://console.16-61-50-207.sslip.io/console"
    },
    {
      "source": "/console/:path*",
      "destination": "https://console.16-61-50-207.sslip.io/console/:path*"
    },
    {
      "source": "/",
      "destination": "https://pawlr.16-61-50-207.sslip.io/"
    },
    {
      "source": "/:path*",
      "destination": "https://pawlr.16-61-50-207.sslip.io/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
