# Pawlr environment. Copy to .env and fill in locally. NEVER commit .env.
# Values here are placeholders only.

# ── SERV Reasoning (OpenServ) ────────────────────────────────────────────────
# Key from console.openserv.ai. Base URL is fixed in code:
# https://inference-api.openserv.ai/v1 (docs.openserv.ai, chat-completions.md)
SERV_API_KEY=
# Model used for the seller's summaries and the verifier's rulings.
SERV_MODEL=gpt-5.4-mini

# ── Dolphin (first-pass relevance screen) ────────────────────────────────────
# UNKNOWN until Maris provides the Dolphin docs: base URL, auth and model ID.
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=
DOLPHIN_MODEL=

# ── Reppo (independent verdicts on disputed ticks) ───────────────────────────
# UNKNOWN until Maris provides the Reppo docs.
REPPO_API_KEY=
REPPO_BASE_URL=

# ── Kite x402 (seller) ───────────────────────────────────────────────────────
# testnet = pieUSD on eip155:2368, mainnet = USDC.e on eip155:2366
# (gokite-ai/kite-x402-services, templates/typescript-express/src/kite.ts).
# Mainnet needs Maris to say "go mainnet".
KITE_NETWORK=testnet
# Kite wallet address that receives tick payments. A placeholder is refused on mainnet.
SELLER_PAY_TO=0x0000000000000000000000000000000000000000
# Price per tick in USD-pegged token units (decimal string). Mainnet guard: <= 0.05.
PRICE_PER_TICK=0.001
# Optional override. Default from Kite's template: https://facilitator.pieverse.io/v2
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Public https URL of the deployed seller (Kite Passport cannot reach localhost).
PUBLIC_BASE_URL=
# Public port (free session routes + paid x402 paywall share it).
PORT=8080
# Bind address for PORT. Use 127.0.0.1 when Caddy (or another proxy) fronts the seller.
HOST=0.0.0.0
# Internal tick service port (always bound to 127.0.0.1).
INTERNAL_TICK_PORT=8081
# Admin password for the failure switch and add-evidence route. Mainnet guard: >= 16 chars.
ADMIN_PASSWORD=

# ── Buyer ────────────────────────────────────────────────────────────────────
# Hard cap per session (token units). Required on mainnet; the buyer refuses to start without it.
MAX_SPEND=0.01
